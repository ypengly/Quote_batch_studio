{
  "schema_version": 1,
  "name": "One More Step",
  "quotes": [
    {
      "id": "820144ba",
      "text": "You're not behind. There is no schedule everyone else is following.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "8d160a85",
      "text": "You don't need the whole map. You need the next step.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "bc02e7cd",
      "text": "Stop waiting to feel ready. Ready is a myth for people who never start.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "3da51b63",
      "text": "You haven't failed. You've just outgrown a version of yourself.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "e9d7c161",
      "text": "Keep going.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "8c6c8499",
      "text": "Small steps still move you forward.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "00e3cc84",
      "text": "The version of you that gives up never finds out what was on the other side.",
      "author": "",
      "category": "",
      "selected": true
    },
    {
      "id": "38ce8438",
      "text": "You are allowed to start again, as many times as you need to.",
      "author": "",
      "category": "",
      "selected": true
    }
  ],
